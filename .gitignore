# ===========================================
# Q-Verifier .gitignore
# ===========================================

# Model weights (too large for git)
*.pt
*.pth
*.bin
*.safetensors
*.gguf

# Intermediate checkpoints
**/checkpoint-*/

# ===========================================
# ALL TRAINED MODELS (too large for GitHub)
# ===========================================

# Catch-all patterns for model directories
**/qwen*_vl_*/
**/final/
**/checkpoint-*/

# SFT models
SFT/qwen*/

# Distilled models  
Teacher_Student_Distill/qwen*/

# DPO models
Rejection_Sampling_DPO/qwen*/

# GRPO models
GRPO/qwen*/

# Compiled cache
**/unsloth_compiled_cache/
**/__pycache__/
*.pyc
*.pyo

# Hugging Face cache
.cache/
~/.cache/huggingface/

# Large archives
*.tar.gz
*.zip

# Training data images (download separately)
**/images/
**/images.zip
SFT/training_data_filtered/images/
SFT/training_data/images/
Data_Corruption/corrupted_data/images/

# Training data directories (large, regeneratable)
SFT/training_data_64/
SFT/training_data_corruption_1/

# Testing data (download separately)
testing_data_androidworld/

# Training outputs
wandb/
outputs/
logs/
*.log

# Environment
.env
.env.local
venv/
.venv/
env/
venv_*/
**/venv_*/

# Android World specific
Agent-SAMA-main/android_world/runs/
Agent-SAMA-main/android_world/screenshot/
Agent-SAMA-main/android_world/build/
Agent-SAMA-main/android_world/qverifier_logs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp

# Screenshots and images at root
*.jpg
*.png
!Results/**/*.png
!Results/**/*.jpg

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# ===========================================
# Keep these (don't ignore)
# ===========================================
# !**/final/  # Keep final model configs (weights still ignored)
# !**/*.json  # Keep config files
# !**/*.md    # Keep documentation
