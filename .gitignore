# ===========================================
# Q-Verifier .gitignore
# ===========================================

# Model weights (too large for git)
*.pt
*.pth
*.bin
*.safetensors
*.gguf

# Intermediate checkpoints
**/checkpoint-*/

# ===========================================
# ALL TRAINED MODELS (too large for GitHub)
# ===========================================

# Catch-all patterns for model directories
**/qwen*_vl_*/
**/final/
**/checkpoint-*/

# SFT models
SFT/qwen*/

# Distilled models  
Teacher_Student_Distill/qwen*/

# DPO models
Rejection_Sampling_DPO/qwen*/

# GRPO models
GRPO/qwen*/

# Compiled cache
**/unsloth_compiled_cache/
**/__pycache__/
*.pyc
*.pyo

# Hugging Face cache
.cache/
~/.cache/huggingface/

# Large archives
*.tar.gz
*.zip

# Training data images (download separately)
**/images/
**/images.zip
SFT/training_data_filtered/images/
SFT/training_data/images/
Data_Corruption/corrupted_data/images/

# Training data directories (large, regeneratable)
SFT/training_data_64/
SFT/training_data_corruption_1/

# Testing data (download separately)
testing_data_androidworld/

# Training outputs
wandb/
outputs/
logs/
*.log

# Environment
.env
.env.local
venv/
.venv/
env/
venv_*/
**/venv_*/

# Retired integration (removed from the maintained source tree)
/Agent-SAMA-main/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp

# Screenshots and images at root
*.jpg
*.png

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# ===========================================
# Keep these (don't ignore)
# ===========================================
# !**/final/  # Keep final model configs (weights still ignored)
# !**/*.json  # Keep config files
# !**/*.md    # Keep documentation

# Local data and review exports. Keep only the frozen dataset contracts in Git.
/datasets/**
!/datasets/*/
!/datasets/*/prompt_template.txt
!/datasets/*/FROZEN.json
!/datasets/*/README.txt
!/datasets/*/manifest.json
!/datasets/*/DATASET_MANIFEST.json
/datasets/current
/review/
/Teacher_Student_Distill/gpt_data_882_luna_supplement_20261012/

# MobileWorld is maintained as source inside this repository. Runtime assets
# remain external, including any local symlinks to the original server workspace.
/MobileWorld/artifacts/
/MobileWorld/traj_logs/
/MobileWorld/.venv/
/MobileWorld/vllm_env/
/MobileWorld/unsloth_compiled_cache/
/MobileWorld/docker/adbkey*
/MobileWorld/docker/mastodon-docker/data/
/MobileWorld/docker/mastodon-docker/.env.dev
/MobileWorld/docker/mattermost-docker/volumes*/
/MobileWorld/docker/mattermost-docker/data.jsonl
/MobileWorld/docker/mattermost-docker/data.zip
/MobileWorld/docker/*.avd*/
!/MobileWorld/assets/**/*.png
!/MobileWorld/assets/**/*.jpg
!/MobileWorld/src/**/*.png
!/MobileWorld/src/**/*.jpg
!/MobileWorld/src/**/*.jpeg

# Never track local credentials or transport keys.
.env.*
!.env.example
*.pem
*.key
*.run.lock

# Retired manuscript drafts and duplicated historical documentation.
/RESEARCH_DOCUMENTATION.txt
/RESEARCH_PAPER.*
/docs/archive/

# Runtime assets and generated research output. Keep existing server copies
# in place; they are not part of a source checkout. The canonical DPO dataset,
# its manifest/audit, frozen input contracts and MobileWorld task assets remain tracked.
/Results/
/SFT/training_data/
/SFT/training_data_filtered/
/SFT/Sample_val_res/
/SFT/test_results_*.json
/Teacher_Student_Distill/gpt_data/
/Teacher_Student_Distill/review_82_exact_source.txt
/Teacher_Student_Distill/review_82_indices.json
/Teacher_Student_Distill/scroll_explore_indices.json
/Teacher_Student_Distill/subgoal_mismatch_indices.json
/Data_Corruption/corrupted_data/
/Rejection_Sampling_DPO/candidate_responses*.jsonl
