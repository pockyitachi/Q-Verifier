# ===========================================
# Q-Verifier .gitignore
# ===========================================

# Model weights (too large for git)
*.pt
*.pth
*.bin
*.safetensors
*.gguf

# Intermediate checkpoints
**/checkpoint-*/

# Trained model directories (download separately)
SFT/qwen3_vl_verifier_4b/
SFT/qwen3_vl_verifier_8b/
SFT/qwen25_vl_verifier_3b/
SFT/qwen25_vl_verifier_7b/
Teacher_Student_Distill/qwen3_vl_verifier_distilled_4b/
Teacher_Student_Distill/qwen3_vl_verifier_distilled_8b/
Teacher_Student_Distill/qwen25_vl_verifier_distilled_3b/
Teacher_Student_Distill/qwen25_vl_verifier_distilled_7b/

# Compiled cache
**/unsloth_compiled_cache/
**/__pycache__/
*.pyc
*.pyo

# Hugging Face cache
.cache/
~/.cache/huggingface/

# Large archives
*.tar.gz
*.zip

# Training data images (download separately)
**/training_data_filtered/images/
**/training_data_filtered/images.zip
**/training_data/images/
Data_Corruption/corrupted_data/images/

# Testing data (download separately)
testing_data_androidworld/

# Training outputs
wandb/
outputs/
logs/
*.log

# Environment
.env
.env.local
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# ===========================================
# Keep these (don't ignore)
# ===========================================
# !**/final/  # Keep final model configs (weights still ignored)
# !**/*.json  # Keep config files
# !**/*.md    # Keep documentation
